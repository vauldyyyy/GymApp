# Local API. Copy to .env and fill only the services you configure.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
SQLITE_PATH=./data/forma.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
SESSION_DAYS=30

# For PostgreSQL, uncomment and supply your own connection URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/forma

# Must exactly match RevenueCat dashboard's webhook Authorization header.
# Missing value disables the webhook with HTTP 503.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_PRO_ENTITLEMENT=forma_pro
# Production should use PRODUCTION; SANDBOX allows native purchase testing.
REVENUECAT_ENVIRONMENT=SANDBOX
